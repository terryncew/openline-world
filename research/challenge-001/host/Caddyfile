# CHALLENGE-001 hosted receiver — TLS edge (proposal; not deployed)
#
# Caddy terminates TLS and reverse-proxies to the loopback-only backend.
# The backend keeps binding 127.0.0.1 (WORKSHOP_HOST); it is never
# exposed directly. Substitute the real domain and certificate paths
# before use.

{
	admin off
}

{$CHALLENGE_DOMAIN:challenge.example.com} {

	# TLS: Caddy's automatic HTTPS (Let's Encrypt) is preferred when a
	# real domain is available. For a pre-provisioned certificate, use:
	# tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	tls {$ACME_EMAIL:hostmaster@example.com}

	# Request body cap: 1 MB. The world server enforces its own, smaller
	# ceilings (256 KB HTTP bodies; 16 KB per contribution) and exact
	# byte pinning; the proxy cap is a coarse edge guard.
	request_body {
		max_size 1MB
	}

	# Per-IP rate limits. Caddy >= 2.8 has rate_limit built in; verify the
	# installed version supports this block before relying on it.
	rate_limit {
		zone challenge_ip {
			key {remote_host}
		}
		events 120
		window 1m
	}

	# Only one route: everything goes to the loopback backend. No direct
	# backend exposure anywhere on this host's public interfaces.
	reverse_proxy 127.0.0.1:8471 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	# Access log policy: method, path, status, latency, request id only.
	# Authorization headers, request bodies, and response bodies are
	# dropped at the log formatter. Receipt ids are application data:
	# they are issued and recorded by the receiver, not the proxy, and
	# stay in the world's durable store — never in these logs.
	log {
		output file /var/log/caddy/challenge-access.log
		format filter {
			wrap console
			fields {
				request>headers delete
				request>body delete
				resp_headers delete
			}
		}
	}
}
