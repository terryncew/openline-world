# CHALLENGE-001 hosted receiver — TLS edge (verified 2026-09-28 with
# real Caddy v2.10.2 against a disposable backend; NOT yet run on the
# production host).
#
# Caddy terminates TLS and reverse-proxies to the loopback-only backend.
# The backend keeps binding 127.0.0.1 (WORKSHOP_HOST); it is never
# exposed directly.
#
# No domain, no ACME: the site address is the server's public IP and the
# certificate is self-signed from Caddy's internal CA (`tls internal`).
# Participants pin the certificate's SHA-256 fingerprint out of band
# (see REMOTE-JOIN.md); the pin is the only trust anchor. The fingerprint
# persists in Caddy's storage across restarts — a host rebuild generates
# a new one, which is published out of band before any participant
# connects.

{
	admin off
}

https://<server-ip> {

	tls internal

	# Request body cap: 256 KB, aligned with the world server's own
	# 256 KB HTTP body ceiling. Oversized bodies get a uniform 413 at
	# the edge (verified: a 2 MB POST returns 413). The contribution
	# body's own cap is 16 KB; legitimate ceremony traffic is far
	# smaller than this limit. Do NOT raise the edge cap above the
	# backend's ceiling: a sub-edge-cap oversized body otherwise reaches
	# the backend, which aborts the connection mid-stream and the edge
	# reports a confusing 502 (observed in testing).
	request_body {
		max_size 256KB
	}

	# No proxy-level rate limiting: stock Caddy v2.10.2 ships no
	# `rate_limit` directive (verified via `caddy list-modules`), and the
	# threat model is one invited participant with a manually issued
	# per-participant mandate — not the open internet. If the
	# participant set grows, revisit with an explicit module choice.
	# Abuse is handled by the receiver: per-mandate scopes, 600s bundle
	# TTLs, single-use gate challenges, and the refusal ledger.

	# Only one route: everything goes to the loopback backend. No direct
	# backend exposure anywhere on this host's public interfaces.
	reverse_proxy 127.0.0.1:8471 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	# Access log policy: method, path, status, latency, TLS info only.
	# Headers and bodies are dropped at the formatter (verified: the
	# emitted lines carry request metadata only). Receipt ids are
	# application data: issued and recorded by the receiver, not the
	# proxy, and stay in the world's durable store — never in these logs.
	log {
		output file /var/log/caddy/challenge-access.log
		format filter {
			wrap console
			fields {
				request>headers delete
				request>body delete
				resp_headers delete
			}
		}
	}
}
