# /etc/openline-world/env — environment for the CHALLENGE-001 hosted receiver
#
# WORKSHOP_HOST stays 127.0.0.1. The backend never binds publicly;
# reachability from the internet comes from the TLS reverse proxy in
# front of it, not from loosening this. Changing WORKSHOP_HOST to a
# public interface is explicitly out of scope.

WORKSHOP_HOST=127.0.0.1
WORKSHOP_PORT=8471

# Persistent volume mount. The world snapshot (including the receiver
# gate's private key, gate_private_key_hex) lives under this dir.
# Backups and restores operate on this path (see ops-runbook.md).
WORLD_DATA_DIR=/var/lib/openline-world
